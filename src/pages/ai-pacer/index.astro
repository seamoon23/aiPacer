---
import AdPlaceholder from "../../components/AdPlaceholder.astro";
import AiPacerApp from "../../components/AiPacerApp";
import Layout from "../../components/Layout.astro";
import { getAiPacerStructuredData } from "../../lib/seo";
import { SITE_URL } from "../../lib/siteMetadata";

const structuredData = getAiPacerStructuredData(`${SITE_URL}/ai-pacer/`);
---

<Layout
  title="AI Pacer - 주간 AI 용량 작업 횟수 계산기"
  description="주간 남은 용량과 초기화 일정을 입력하면 오늘 가능한 소형, 중형, 대형 작업 횟수를 추정하는 무료 계산기입니다."
  pathname="/ai-pacer/"
  structuredData={structuredData}
>
  <AiPacerApp client:load />
  <AdPlaceholder />
</Layout>
