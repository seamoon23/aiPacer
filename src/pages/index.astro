---
import AdPlaceholder from "../components/AdPlaceholder.astro";
import Layout from "../components/Layout.astro";
import UtilityCard from "../components/UtilityCard.astro";
import { withBasePath } from "../lib/siteMetadata";
---

<Layout
  title="AI Pacer - 무료 웹 유틸리티 01"
  description="로그인과 AI 연동 없이 브라우저에서 바로 쓰는 간단한 웹 유틸리티 모음입니다. 첫 번째 도구는 AI Pacer입니다."
  pathname="/"
>
  <section class="hub-intro">
    <p class="eyebrow">SIMPLE UTILITY</p>
    <h1>무료 웹 유틸리티</h1>
    <p class="lead">
      복잡한 가입이나 연동 없이 필요한 계산만 바로 처리합니다. 첫 번째 도구는 주간 AI 용량을 오늘 작업 횟수로 바꾸는 <strong>AI Pacer</strong>입니다.
    </p>
  </section>

  <section class="utility-catalog" aria-labelledby="utility-catalog-title">
    <header class="section-head">
      <div>
        <p class="eyebrow">AVAILABLE</p>
        <h2 id="utility-catalog-title">지금 쓸 수 있는 도구</h2>
      </div>
      <p>모든 계산은 현재 화면 안에서만 처리합니다.</p>
    </header>

    <div class="utility-grid">
      <UtilityCard
        title="AI Pacer"
        description="주간 남은 용량, Claude 플랜과 초기화 일정을 넣고 오늘 가능한 소형, 중형, 대형 작업 횟수를 확인합니다."
        href={withBasePath("/ai-pacer/")}
        badge="01"
        imageSrc={withBasePath("/assets/ai-pacer-icon.png")}
        imageAlt="굵은 안경을 쓴 샴고양이 달콤이 코치"
      />
      <UtilityCard
        title="다음 유틸리티"
        description="같은 원칙으로 한 가지 계산을 빠르게 끝내는 도구를 추가할 예정입니다."
        badge="02"
      />
    </div>
  </section>

  <AdPlaceholder />
</Layout>