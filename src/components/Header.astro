---
type Props = {
  pathname: string;
};

const { pathname } = Astro.props;

const links = [
  { href: "/", label: "홈" },
  { href: "/ai-pacer/", label: "AI Pacer" },
  { href: "/about/", label: "About" }
];
---

<header class="site-header">
  <div class="header-bar">
    <a class="brand-mark" href="/">
      <img
        class="brand-icon"
        src="/assets/ai-pacer-icon.png"
        width="44"
        height="44"
        alt=""
      />
      <span class="brand-copy">
        <strong>AI Pacer</strong>
        <span>주간 용량을 오늘 작업 횟수로</span>
      </span>
    </a>
    <nav class="nav-links" aria-label="주요 메뉴">
      {
        links.map((link) => (
          <a
            href={link.href}
            class={pathname === link.href ? "is-active" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
