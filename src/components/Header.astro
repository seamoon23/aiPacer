---
import { withBasePath } from "../lib/siteMetadata";

type Props = {
  pathname: string;
};

const { pathname } = Astro.props;

const links = [
  { route: "/", href: withBasePath("/"), label: "홈" },
  { route: "/ai-pacer/", href: withBasePath("/ai-pacer/"), label: "AI Pacer" },
  { route: "/about/", href: withBasePath("/about/"), label: "About" }
];
---

<header class="site-header">
  <div class="header-bar">
    <a class="brand-mark" href={withBasePath("/")}>
      <img
        class="brand-icon"
        src={withBasePath("/assets/ai-pacer-icon.png")}
        width="44"
        height="44"
        alt=""
      />
      <span class="brand-copy">
        <strong>AI Pacer</strong>
        <span>주간 용량을 오늘 작업 횟수로</span>
      </span>
    </a>
    <nav class="nav-links" aria-label="주요 메뉴">
      {
        links.map((link) => (
          <a
            href={link.href}
            class={pathname === link.route ? "is-active" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
